.DS_Store
__pycache__/
*.pyc
node_modules/
docs/loop.log
docs/LOOP-STOP
docs/loop-watchdog.log
plugins/*-workspace/
.claude/
.vercel
.env*

# improve-skill iteration output — 715MB of r00..r21 loop runs, referenced by
# nothing in the skill, README or evals. Kept locally, out of the repo: the
# marketplace is vendored as a submodule by dAIolog's studio agent, where a
# 1GB checkout for one 6.4MB skill aborted the deploy upload.
plugins/improve-skill/assets/loop-runs/
plugins/*/evals/runs/
.rebuild-workspace/

# Audit and report scratch, not repo content
.scratch/

# better-loop
.claude/loops/

# a symlinked node_modules is not matched by the "node_modules/" directory pattern
site/node_modules
# a symlinked .worktrees is not matched by the "/" directory pattern
.worktrees

# Icon and banner iteration scratch: fidelity loops, per-round renders and the numpy
# arrays behind them. Kept locally, out of the repo. Untracked on 2026-11-14 (about
# 254 MB in the tree); nothing the site, README, conformance gate or any audit sheet
# embeds lives here. audit-renders/ and banner-renders/ stay tracked because
# audit.html and banner-audit.html display them and the gate checks the former.
plugins/*/assets/loop-runs/
plugins/*/assets/fidelity/
plugins/*/assets/fidelity-runs/
*.npy

# Uncompressed originals of the shipped icons and banners (the repo carries
# compressed copies at the same dimensions).
plugins/*/assets/originals/
