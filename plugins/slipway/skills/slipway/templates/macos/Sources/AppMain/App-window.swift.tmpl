import SwiftUI
import AppCore

// Native macOS shell: NavigationSplitView sidebar + top nav with search —
// the standard shape for a document/collection app. Grow sections in
// SidebarItem; keep logic in AppCore.
@main
struct {{APP_NAME}}App: App {
    var body: some Scene {
        WindowGroup {
            ContentView()
        }
        .windowStyle(.automatic)
    }
}

enum SidebarItem: String, CaseIterable, Identifiable {
    case home = "Home"
    case library = "Library"
    case settings = "Settings"
    var id: String { rawValue }
    var icon: String {
        switch self {
        case .home: "house"
        case .library: "books.vertical"
        case .settings: "gearshape"
        }
    }
}

struct ContentView: View {
    @State private var selection: SidebarItem? = .home
    @State private var searchText = ""

    var body: some View {
        NavigationSplitView {
            List(SidebarItem.allCases, selection: $selection) { item in
                Label(item.rawValue, systemImage: item.icon).tag(item)
            }
            .navigationSplitViewColumnWidth(min: 180, ideal: 220)
        } detail: {
            VStack(spacing: 12) {
                Text(selection?.rawValue ?? "{{DISPLAY}}").font(.largeTitle.bold())
                Text(AppCore.greeting).foregroundStyle(.secondary)
            }
            .frame(maxWidth: .infinity, maxHeight: .infinity)
            .navigationTitle("{{DISPLAY}}")
        }
        .searchable(text: $searchText, placement: .toolbar, prompt: "Search")
        .frame(minWidth: 720, minHeight: 460)
    }
}
