<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Exactly one CarPlay key, the one Apple granted. Since iOS 26.3 only charging + fueling may be
     combined. Adding the key here does not grant it: the provisioning profile must carry it too. -->
<plist version="1.0">
<dict>
    <key>com.apple.developer.carplay-audio</key>
    <true/>
</dict>
</plist>
