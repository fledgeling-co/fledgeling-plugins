# Maestro smoke flow (BP §18). Assert by testID, never by copy: text matchers
# are anchored, and a Pressable collapses its children into one label.
# Run: maestro test .maestro/   (brew install maestro; app running in a simulator)
appId: {{BUNDLE_PREFIX}}.mobile
---
- launchApp
- assertVisible:
    id: "app-title"
