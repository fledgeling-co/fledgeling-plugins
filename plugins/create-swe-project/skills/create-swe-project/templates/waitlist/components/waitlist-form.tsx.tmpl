'use client';

import { useEffect, useState } from 'react';
import { useSearchParams } from 'next/navigation';

// The referral loop: each signup via someone's link moves them up the queue.
// Drop this component into the marketing page. Position and share link appear
// only in the browser that joined; joining again from elsewhere just confirms
// the join, so the form never reveals whether an address was already listed.
type Status = { position: number; total: number; refCode: string; referrals: number };

async function fetchOwnStatus(): Promise<Status | null> {
  const res = await fetch('/api/waitlist');
  return res.ok ? ((await res.json()) as Status) : null;
}

export function WaitlistForm(): React.ReactElement {
  const params = useSearchParams();
  const [email, setEmail] = useState('');
  const [status, setStatus] = useState<Status | null>(null);
  const [joined, setJoined] = useState(false);
  const [pending, setPending] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const controller = new AbortController();
    fetch('/api/waitlist', { signal: controller.signal })
      .then(async (res) => (res.ok ? setStatus((await res.json()) as Status) : undefined))
      .catch(() => undefined); // no entry yet, or the request was aborted on unmount
    return () => controller.abort();
  }, []);

  if (status) {
    const shareUrl = `${window.location.origin}/waitlist?ref=${status.refCode}`;
    return (
      <div>
        <p>
          You&apos;re <strong>#{status.position}</strong> of {status.total} on the {'{{DISPLAY}}'} waitlist.
        </p>
        <p>Move up the queue: every person who joins with your link jumps you ahead.</p>
        <code>{shareUrl}</code>
        <button type="button" onClick={() => void navigator.clipboard.writeText(shareUrl)}>Copy link</button>
      </div>
    );
  }

  if (joined) {
    return <p role="status">You&apos;re on the {'{{DISPLAY}}'} waitlist. We&apos;ll be in touch.</p>;
  }

  return (
    <form
      onSubmit={(e) => {
        e.preventDefault();
        setPending(true);
        setError(null);
        fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, ref: params.get('ref') ?? undefined }),
        })
          .then(async (res) => {
            if (!res.ok) return setError('Could not join. Try again.');
            const own = await fetchOwnStatus();
            if (own) setStatus(own);
            else setJoined(true);
          })
          .catch(() => setError('Network error. Check your connection and try again.'))
          .finally(() => setPending(false));
      }}
    >
      <label htmlFor="waitlist-email">Email</label>
      <input id="waitlist-email" type="email" autoComplete="email" required value={email} onChange={(e) => setEmail(e.target.value)} />
      <button type="submit" disabled={pending}>Join the waitlist</button>
      <p role="alert" aria-live="polite">{error}</p>
    </form>
  );
}
