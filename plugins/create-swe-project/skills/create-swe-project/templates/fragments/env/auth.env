
# Auth (BP §9): sign-in JWT key, at least 32 chars. Generate: openssl rand -base64 32
JWT_SECRET=
# Resend (BP §8): API key and a sender on a verified domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Outside production, email and push reach ONLY these comma-separated domains;
# empty means nobody (BP §24). Put your own domain here for local sign-in codes.
OUTBOUND_ALLOWED_DOMAINS=
# Dev login button on /login: development runtime only, decided server-side
DEV_LOGIN_ENABLED=true
DEV_LOGIN_EMAIL=
