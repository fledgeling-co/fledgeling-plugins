  web:
    image: node:24-slim
    working_dir: /repo
    command: ["sh", "-c", "corepack enable && pnpm install --frozen-lockfile && pnpm --filter web dev --hostname 0.0.0.0"]
    ports: ["127.0.0.1:{{PORT_WEB}}:{{PORT_WEB}}"]
    env_file:
      - path: apps/web/.env.local
        required: false
    environment:
      SHELL: /bin/sh
      COREPACK_ENABLE_DOWNLOAD_PROMPT: "0"
      npm_config_store_dir: /pnpm-store
{{COMPOSE_DATA_ENV}}    volumes:
      - .:/repo:cached
      - web_root_modules:/repo/node_modules
      - web_app_modules:/repo/apps/web/node_modules
      - web_pnpm_store:/pnpm-store
{{COMPOSE_MASKS_WEB}}    mem_limit: 4g
    ulimits:
      nofile: { soft: 65536, hard: 65536 }
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:{{PORT_WEB}}/api/health').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 120s
