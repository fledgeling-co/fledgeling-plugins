<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime app, no sandbox by default (Developer ID distribution).
	     Add com.apple.security.app-sandbox if App Store distribution is planned. -->
	<key>com.apple.security.cs.allow-jit</key>
	<false/>
</dict>
</plist>
