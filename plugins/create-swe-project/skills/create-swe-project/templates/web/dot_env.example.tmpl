# Canonical list of the env vars this app reads (BP §13). Copy to .env.local and
# fill. `pnpm check:env` fails when this file and the code disagree (CP §6.8).
# Vercel env is the source of truth for preview/production: `vercel env pull .env.local`.

# This app's public origin, behind the shared Caddy proxy (BP §20). Also the
# origin state-changing requests must come from (CP §6.1).
NEXT_PUBLIC_APP_URL=http://{{HOST}}

# Runtime environment when the platform doesn't say (production | preview |
# development). Vercel sets VERCEL_ENV, so leave this empty there; set it to
# production on any other production host (BP §24).
APP_ENV=

# AI (BP §6): AI Gateway routes across providers; ANTHROPIC_API_KEY alone works for local dev.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=

# 1Password (CLAUDE.md § Secrets): account/team id + this project's vault.
# scripts/env-pull.sh resolves op:// references in .env.local via the op CLI.
OP_ACCOUNT=
OP_VAULT=
