#!/usr/bin/env node
// Serve the `output: 'standalone'` build the way production runs it. `next start`
// does not serve a standalone build (CP §6.7), and server.js expects the static
// assets and public/ copied beside it.
import { cpSync, existsSync } from 'node:fs';
import { spawn } from 'node:child_process';
import { join } from 'node:path';

const app = process.cwd();
const standalone = join(app, '.next', 'standalone');
// With the monorepo as tracing root, the server lands under apps/<app>/.
const nested = join(standalone, 'apps', 'web');
const serverDir = existsSync(join(nested, 'server.js')) ? nested : standalone;
if (!existsSync(join(serverDir, 'server.js'))) {
  console.error('no standalone build found: run `pnpm build` first');
  process.exit(1);
}
cpSync(join(app, '.next', 'static'), join(serverDir, '.next', 'static'), { recursive: true });
if (existsSync(join(app, 'public'))) cpSync(join(app, 'public'), join(serverDir, 'public'), { recursive: true });

const child = spawn(process.execPath, [join(serverDir, 'server.js')], {
  stdio: 'inherit',
  env: { ...process.env, PORT: process.env.PORT ?? '{{PORT_WEB}}', HOSTNAME: process.env.HOSTNAME ?? '127.0.0.1' },
});
for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => child.kill(sig));
child.on('exit', (code) => process.exit(code ?? 0));
