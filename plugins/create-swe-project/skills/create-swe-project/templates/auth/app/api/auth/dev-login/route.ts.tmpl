import { NextResponse, type NextRequest } from 'next/server';
import { mintSession } from '@/lib/auth-server';
import { devLoginEnabled } from '@/lib/dev-login';
import { optionalEnv } from '@/lib/env';
import { isAllowedOrigin, jsonError } from '@/lib/http';
import { findOrCreateUser } from '@/lib/users';

export const runtime = 'nodejs';

// One-click session as the dev user. Anywhere else the route does not exist.
export async function POST(req: NextRequest): Promise<Response> {
  if (!devLoginEnabled()) return jsonError('Not found', 404);
  if (!isAllowedOrigin(req)) return jsonError('Forbidden', 403);
  const user = await findOrCreateUser(optionalEnv('DEV_LOGIN_EMAIL', 'dev@{{HOST}}'));
  await mintSession({ userId: user.id, email: user.email });
  return NextResponse.json({ ok: true });
}
