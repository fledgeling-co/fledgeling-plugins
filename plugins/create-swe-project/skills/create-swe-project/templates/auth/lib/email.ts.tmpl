import 'server-only';
import type { ReactElement } from 'react';
import { Resend } from 'resend';
import { SignInCodeEmail } from '@/emails/sign-in-code';
import { WelcomeEmail } from '@/emails/welcome';
import { optionalEnv, requireEnv } from './env';
import { logger } from './logger';
import { canReceiveOutbound } from './outbound';

// Resend + React Email (BP §8): one named export per template, verified sender
// from env. React Email escapes interpolated text, so no escapeHtml here.

async function send(to: string, subject: string, react: ReactElement): Promise<void> {
  if (!canReceiveOutbound(to)) {
    logger.info({ domain: to.slice(to.lastIndexOf('@') + 1) }, 'outbound email suppressed outside production');
    return;
  }
  const resend = new Resend(requireEnv('RESEND_API_KEY'));
  // The SDK reports failure in its result rather than throwing.
  const { error } = await resend.emails.send({
    from: optionalEnv('RESEND_FROM_EMAIL', '{{DISPLAY}} <onboarding@resend.dev>'),
    to,
    subject,
    react,
  });
  if (error) throw new Error(`Resend rejected the email: ${error.message}`);
}

export function sendSignInCodeEmail(to: string, code: string): Promise<void> {
  return send(to, `${code} is your {{DISPLAY}} sign-in code`, SignInCodeEmail({ code }));
}

export function sendWelcomeEmail(to: string): Promise<void> {
  return send(to, 'Welcome to {{DISPLAY}}', WelcomeEmail({ email: to }));
}
