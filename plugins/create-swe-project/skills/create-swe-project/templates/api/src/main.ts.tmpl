// Dev boot runs through @swc-node/register — the SAME transform as the prod build
// (nest build -b swc) — so SWC-only boot crashes (circular-import TDZ) reproduce
// locally (BP §15). Don't switch dev to ts-node/tsc.
import 'reflect-metadata';
import helmet from 'helmet';
import { ValidationPipe } from '@nestjs/common';
import { NestFactory } from '@nestjs/core';
import { DocumentBuilder, SwaggerModule } from '@nestjs/swagger';
import { AppModule } from './app.module';

async function bootstrap() {
  const app = await NestFactory.create(AppModule);
  app.use(helmet());
  // Global validation (CP §2): whitelist strips undeclared fields so an attacker
  // can't slip extras into a DTO; transform materialises typed instances.
  app.useGlobalPipes(new ValidationPipe({ whitelist: true, transform: true }));
  const openapi = new DocumentBuilder()
    .setTitle('{{DISPLAY}} API')
    .setVersion('0.1.0')
    .build();
  SwaggerModule.setup('docs', app, SwaggerModule.createDocument(app, openapi));
  app.enableShutdownHooks();
  await app.listen({{PORT_API}});
  console.log(`api listening on :{{PORT_API}} (http://api.{{CODENAME}}.local — OpenAPI at /docs)`);
}
void bootstrap();
