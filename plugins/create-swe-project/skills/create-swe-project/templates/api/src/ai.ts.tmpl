import { generateText, Output, type LanguageModel } from 'ai';
import { anthropic } from '@ai-sdk/anthropic';
import { z } from 'zod';

// The Vercel AI SDK is the AI layer here, as in apps/web (BP §6); never raw
// provider SDKs. Model IDs live in ONE config object; verify them against the
// live list before changing (curl -s https://ai-gateway.vercel.sh/v1/models).
export const MODELS = {
  default: 'anthropic/claude-sonnet-5.5',
  fast: 'anthropic/claude-haiku-5.5',
} as const;

// "provider/model" routes through AI Gateway when AI_GATEWAY_API_KEY or
// VERCEL_OIDC_TOKEN is set, else the direct provider, whose IDs use dashes (BP §6).
export function resolveModel(id: string): LanguageModel {
  if (process.env.AI_GATEWAY_API_KEY || process.env.VERCEL_OIDC_TOKEN) return id;
  if (!process.env.ANTHROPIC_API_KEY) {
    throw new Error('No AI credentials: set AI_GATEWAY_API_KEY, or ANTHROPIC_API_KEY for local dev');
  }
  return anthropic(id.replace(/^anthropic\//, '').replace(/\./g, '-'));
}

// Model output is a trust boundary (CP §1): schema-enforced via Output.object.
const summarySchema = z.object({ tldr: z.string(), bullets: z.array(z.string()) });
export type Summary = z.infer<typeof summarySchema>;

export async function summarise(input: string): Promise<Summary> {
  const { output } = await generateText({
    model: resolveModel(MODELS.default),
    prompt: input,
    output: Output.object({ schema: summarySchema }),
  });
  return output;
}
