import 'server-only';
import { cookies } from 'next/headers';
import { SignJWT, errors, jwtVerify } from 'jose';
import { createHmac, randomInt, timingSafeEqual } from 'node:crypto';
import { Resend } from 'resend';
import { optionalEnv, requireEnv, requireSecret } from './env';
import { logger } from './logger';
import { redis } from './redis';

// A distinct trust domain (BP §9.5, CP §6.1): its own secret and audience, so a
// user-side key compromise can't mint admin tokens. Access is an explicit email
// allowlist with email-code sign-in, the multi-admin variant BP §9.5 calls for
// once more than one person administers.
const ALGORITHM = 'HS256';
const ISSUER = '{{CODENAME}}';
const AUDIENCE = '{{CODENAME}}-admin';
const SECURE = process.env.NODE_ENV === 'production';
const COOKIE = SECURE ? '__Host-admin_session' : 'admin_session';
const TTL_S = 60 * 60 * 12; // 12h: admin sessions stay short and have no refresh path
const CODE_TTL_S = 600;

const key = (): Uint8Array => new TextEncoder().encode(requireSecret('ADMIN_JWT_SECRET'));
const hmac = (v: string): string => createHmac('sha256', requireSecret('ADMIN_JWT_SECRET')).update(v).digest('hex');

export function isAdminEmail(email: string): boolean {
  const list = requireEnv('ADMIN_EMAILS').split(',').map((e) => e.trim().toLowerCase()).filter(Boolean);
  return list.includes(email.trim().toLowerCase());
}

async function sendCode(email: string, code: string): Promise<void> {
  const { error } = await new Resend(requireEnv('RESEND_API_KEY')).emails.send({
    from: optionalEnv('RESEND_FROM_EMAIL', '{{DISPLAY}} <onboarding@resend.dev>'),
    to: email,
    subject: `${code} is your {{DISPLAY}} admin code`,
    text: `Your {{DISPLAY}} admin sign-in code is ${code}. It expires in 10 minutes.`,
  });
  if (error) throw new Error(`Resend rejected the admin code email: ${error.message}`);
}

/**
 * Issue a code when the address is on the allowlist. The per-email counter runs
 * for every address and the send is deferred by the caller (via after()), so a
 * non-admin and an admin get the same response in the same time (CP §6.1).
 * Returns the deferred send, or null when there is nothing to send.
 */
export async function requestAdminCode(email: string): Promise<(() => Promise<void>) | null> {
  const client = await redis();
  const rateKey = `admin:rate:${email}`;
  const [count] = await client.multi().incr(rateKey).expire(rateKey, 3600, 'NX').exec();
  if (!isAdminEmail(email) || Number(count) > 3) return null;
  const code = String(randomInt(100000, 1000000));
  await client.set(`admin:code:${email}`, hmac(code), { EX: CODE_TTL_S });
  return () => sendCode(email, code).catch((err: unknown) => logger.error({ err }, 'admin code email failed'));
}

const COMPARE_AND_DELETE = "if redis.call('GET', KEYS[1]) == ARGV[1] then return redis.call('DEL', KEYS[1]) else return 0 end";

export async function verifyAdminCode(email: string, code: string): Promise<boolean> {
  if (!isAdminEmail(email)) return false;
  const client = await redis();
  const codeKey = `admin:code:${email}`;
  const attemptsKey = `admin:attempts:${email}`;
  const [attempts] = await client.multi().incr(attemptsKey).expire(attemptsKey, CODE_TTL_S, 'NX').exec();
  if (Number(attempts) > 5) {
    await client.del(codeKey);
    return false;
  }
  const stored = await client.get(codeKey);
  if (!stored) return false;
  const candidate = hmac(code);
  if (stored.length !== candidate.length || !timingSafeEqual(Buffer.from(stored), Buffer.from(candidate))) return false;
  if (Number(await client.eval(COMPARE_AND_DELETE, { keys: [codeKey], arguments: [stored] })) !== 1) return false;
  await client.del(attemptsKey);
  const token = await new SignJWT({ email })
    .setProtectedHeader({ alg: ALGORITHM })
    .setSubject(email)
    .setIssuer(ISSUER)
    .setAudience(AUDIENCE)
    .setIssuedAt()
    .setExpirationTime(`${TTL_S}s`)
    .sign(key());
  (await cookies()).set(COOKIE, token, { httpOnly: true, secure: SECURE, sameSite: 'strict', path: '/', maxAge: TTL_S });
  return true;
}

export async function getAdminSession(): Promise<{ email: string } | null> {
  const token = (await cookies()).get(COOKIE)?.value;
  if (!token) return null;
  try {
    const { payload } = await jwtVerify(token, key(), { algorithms: [ALGORITHM], issuer: ISSUER, audience: AUDIENCE });
    // Re-check the allowlist on every request, so removing an address revokes access.
    return typeof payload.sub === 'string' && isAdminEmail(payload.sub) ? { email: payload.sub } : null;
  } catch (err: unknown) {
    if (err instanceof errors.JOSEError) return null;
    throw err;
  }
}

export async function clearAdminSession(): Promise<void> {
  (await cookies()).delete(COOKIE);
}
