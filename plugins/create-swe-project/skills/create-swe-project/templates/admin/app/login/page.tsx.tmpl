'use client';

import { useState } from 'react';
import { useRouter } from 'next/navigation';

async function post(path: string, body: unknown): Promise<boolean> {
  const res = await fetch(path, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
  return res.ok;
}

export default function AdminLoginPage(): React.ReactElement {
  const router = useRouter();
  const [email, setEmail] = useState('');
  const [code, setCode] = useState('');
  const [stage, setStage] = useState<'email' | 'code'>('email');
  const [pending, setPending] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function attempt(action: () => Promise<boolean>, onSuccess: () => void, failure: string): Promise<void> {
    setPending(true);
    setError(null);
    try {
      if (await action()) onSuccess();
      else setError(failure);
    } catch {
      setError('Network error. Try again.');
    } finally {
      setPending(false);
    }
  }

  return (
    <main style={{ maxWidth: 360, margin: '0 auto', padding: '4rem 1.5rem' }}>
      <h1>{{DISPLAY}} Admin</h1>
      {stage === 'email' ? (
        <form onSubmit={(e) => { e.preventDefault(); void attempt(() => post('/api/admin-auth/request-code', { email }), () => setStage('code'), 'Could not send a code.'); }}>
          <label htmlFor="email">Email</label>
          <input id="email" type="email" autoComplete="email" required value={email} onChange={(e) => setEmail(e.target.value)} />
          <button type="submit" disabled={pending}>Email me a code</button>
        </form>
      ) : (
        <form onSubmit={(e) => { e.preventDefault(); void attempt(() => post('/api/admin-auth/verify', { email, code }), () => router.push('/'), 'Invalid or expired code.'); }}>
          <label htmlFor="code">6-digit code</label>
          <input id="code" inputMode="numeric" autoComplete="one-time-code" pattern="\d{6}" required value={code} onChange={(e) => setCode(e.target.value)} />
          <button type="submit" disabled={pending}>Sign in</button>
        </form>
      )}
      <p role="alert" aria-live="polite">{error}</p>
    </main>
  );
}
