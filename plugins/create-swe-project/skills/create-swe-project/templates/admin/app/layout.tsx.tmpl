import type { Metadata } from 'next';
import { headers } from 'next/headers';

export const metadata: Metadata = { title: '{{DISPLAY}} Admin', robots: { index: false, follow: false } };

// Async so every page renders per request and carries a fresh CSP nonce (CP §6.7).
export default async function RootLayout({ children }: { children: React.ReactNode }): Promise<React.ReactElement> {
  await headers();
  return (
    <html lang="en">
      <body style={{ margin: 0, fontFamily: 'system-ui, sans-serif' }}>{children}</body>
    </html>
  );
}
