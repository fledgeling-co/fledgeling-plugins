import { redirect } from 'next/navigation';
import { getAdminSession } from '@/lib/auth-admin';

// Server-guarded shell: every admin page calls getAdminSession(); the guard
// lives server-side, never in client state (BP §24). Every admin mutation you
// add writes its audit entry in the same transaction (BP §12, CP §6.8) and gets
// a test that an unauthorised caller is denied (BP §15).
export default async function AdminHome(): Promise<React.ReactElement> {
  const session = await getAdminSession();
  if (!session) redirect('/login');
  return (
    <main style={{ maxWidth: '48rem', margin: '0 auto', padding: '4rem 1.5rem' }}>
      <h1>{{DISPLAY}} Admin</h1>
      <p>Signed in as {session.email}.</p>
      <p>Add admin surfaces here; every privileged mutation gets an authz test and an audit-log entry.</p>
    </main>
  );
}
