{
  "name": "fledgeling-skills-site",
  "version": "0.1.0",
  "private": true,
  "description": "skills.fledgeling.app — searchable directory for the fledgeling-plugins marketplace",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prebuild": "node scripts/build-catalogue.mjs",
    "predev": "node scripts/build-catalogue.mjs",
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsgo --noEmit",
    "embeddings": "node scripts/build-embeddings.mjs",
    "digest:seed": "node --env-file-if-exists=.env.local scripts/digest-seed.mjs",
    "digest:draft": "node --env-file-if-exists=.env.local scripts/digest-draft.mjs",
    "digest:approve": "node --env-file-if-exists=.env.local scripts/digest-approve.mjs",
    "digest:hold": "node --env-file-if-exists=.env.local scripts/digest-hold.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-email/components": "^1.0.12",
    "ai": "^7",
    "gsap": "^3.15.0",
    "mongoose": "^9.9.2",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript/native-preview": "latest",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "typescript": "^6"
  }
}
