# The site renders entirely from a build-time catalogue, so nothing here is
# needed for the pages. These only power the AI search lane; without them
# /api/search returns 503 and the UI falls back to local ranking.

# Routes through Vercel AI Gateway. On Vercel this is set as a project env var;
# locally it belongs in .env.local, which is gitignored.
AI_GATEWAY_API_KEY=

# Canonical origin — metadata, sitemap, and the same-origin check on /api/search.
NEXT_PUBLIC_SITE_URL=https://skills.fledgeling.app

# Rate limiting for /api/search. Best-effort per instance; the durable control
# is a Vercel WAF rule.
SEARCH_RATE_PER_MINUTE=8
SEARCH_DAILY_CEILING=2000

# ── Email subscription ────────────────────────────────────────────────────────
# All four are needed for sign-up to work. Without MONGODB_URI or
# SUBSCRIBE_TOKEN_SECRET the form says so plainly rather than failing silently;
# without the Resend pair the address is still saved and no welcome is sent.

# MongoDB connection string. Its own database; a shared cluster is fine.
MONGODB_URI=

# Signs the preference/unsubscribe links. Any long random string;
# `openssl rand -base64 48` is enough. Rotating it invalidates every
# outstanding link in every email already sent.
SUBSCRIBE_TOKEN_SECRET=

# Resend. The sending domain must be verified in Resend or the welcome lands
# in spam. Format: "Fledgeling Skills <skills@fledgeling.app>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
