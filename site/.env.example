# The site is public and reads its catalogue off the filesystem at build time, so
# nothing here is needed to render the pages. These only power the AI search lane;
# without them /api/search returns a 503 and the UI falls back to local search.

# Preferred: routes through Vercel AI Gateway. On Vercel, VERCEL_OIDC_TOKEN is
# injected automatically and this can be left unset.
AI_GATEWAY_API_KEY=

# Local-dev fallback when there is no gateway. Direct Anthropic API.
ANTHROPIC_API_KEY=

# Canonical origin, used for metadata, sitemap and the same-origin check on
# /api/search.
NEXT_PUBLIC_SITE_URL=https://skills.fledgeling.app

# Rate limiting for /api/search. Best-effort per-instance; the durable control is
# the Vercel WAF rule.
SEARCH_RATE_PER_MINUTE=8
SEARCH_DAILY_CEILING=2000
