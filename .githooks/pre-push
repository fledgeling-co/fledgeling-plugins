#!/bin/sh
#
# Draft the announcement email for any newly published skill, on the push that
# publishes it.
#
# Publishing here is a push: the marketplace entry lands, Vercel rebuilds, and
# the skill is live. So this is the moment the pipeline has to notice, and doing
# it locally means the copy is written by Luke's own Claude subscription rather
# than by an API key sitting in CI.
#
# It only runs when .claude-plugin/marketplace.json actually changed, so an
# ordinary push pays nothing. When it does run it blocks for a minute or so per
# new skill, which is the trade for not having to remember.
#
# Skip it with `SKIP_DIGEST=1 git push`, or `git push --no-verify` to skip every
# hook. Drafting never sends; the worst case for skipping is that a skill ships
# without its email until the next `pnpm digest:draft`.
#
# Install: git config core.hooksPath .githooks

[ "$SKIP_DIGEST" = "1" ] && exit 0

repo_root=$(git rev-parse --show-toplevel) || exit 0
manifest=".claude-plugin/marketplace.json"
zero="0000000000000000000000000000000000000000"

changed=0

# One line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # A new branch. Compare against the default branch rather than walking the
    # whole history, which on a fresh branch would report every file as changed.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
    [ -z "$base" ] && continue
  else
    base="$remote_sha"
  fi

  if ! git diff --quiet "$base" "$local_sha" -- "$manifest" 2>/dev/null; then
    changed=1
  fi
done

[ "$changed" = "0" ] && exit 0

printf '\n  %s changed. Checking for newly published skills.\n' "$manifest"

cd "$repo_root/site" || exit 0

if ! command -v pnpm >/dev/null 2>&1; then
  printf '  pnpm is not on PATH, so no email was drafted. Run `pnpm digest:draft` in site/ afterwards.\n\n'
  exit 0
fi

# Deliberately never blocks the push. A drafting failure is a missing email,
# which is recoverable by re-running the script; a blocked push is not what a
# person wants at the moment they are shipping.
if ! pnpm digest:draft; then
  printf '\n  Drafting failed. The push continues; re-run `pnpm digest:draft` in site/ when you can.\n\n'
fi

exit 0
